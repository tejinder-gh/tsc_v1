# --- Required for lead capture ---
# Catch hook from Zapier / Make / n8n. All form submissions POST here as JSON.
LEAD_WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/XXXXXXX/XXXXXXX/

# --- Booking ---
# Cal.com event link in the form "username/event-slug"
NEXT_PUBLIC_CAL_LINK=theskillcorner/automation-audit

# --- Analytics (set ONE of these; leave both empty to disable) ---
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_GA_ID=

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://theskillcorner.com

# --- Operator dashboard auth & authorization (Clerk) ---
# Required to access /dashboard. Create a Clerk application at https://dashboard.clerk.com
# and copy its API keys here. Without these set, /dashboard fails closed in production.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Server-side allowlist of authorized Clerk user IDs (comma-separated).
# In production, an authenticated Clerk user MUST have their user ID in this list
# to access the dashboard or execute mutations. If unset, empty, or unmatching,
# requests fail closed with Forbidden.
# Example format: user_2xxxxxxxxxxxxxxxxxxxxxxxxx,user_2yyyyyyyyyyyyyyyyyyyyyyyyy
DASHBOARD_OPERATOR_USER_IDS=

# For local development only: explicitly enable local dev operator session without Clerk keys.
# Strictly requires both NODE_ENV=development AND ALLOW_DEV_OPERATOR_AUTH=true. Never active in production.
# ALLOW_DEV_OPERATOR_AUTH=false

# --- SMS Relay (Android -> Next.js -> Downstream Delivery) ---
# Logical identifier for the SMS relay instance (must match Android client)
SMS_RELAY_ID=india-sms

# Authorized device ID (or comma-separated list of device IDs)
SMS_RELAY_DEVICE_ID=india-phone-primary

# High-entropy shared HMAC-SHA256 secret key (min 16 chars; never commit real secrets)
SMS_RELAY_HMAC_SECRET=replace-with-a-strong-random-secret-key-32-chars

# Timestamp freshness window in seconds (default: 300)
SMS_RELAY_TIMESTAMP_WINDOW_SECONDS=300

# Maximum incoming HTTP request body bytes (default: 16384 = 16 KB)
SMS_RELAY_MAX_BODY_BYTES=16384

# Active delivery provider: "email", "webhook", or "dev-null" (default: "email")
SMS_RELAY_DELIVERY_PROVIDER=email

# --- SMS Relay Email Delivery Adapter Settings ---
# Destination email address (e.g. Canadian inbox)
SMS_RELAY_EMAIL_TO=recipient@example.com
# Sender email address
SMS_RELAY_EMAIL_FROM=sms-relay@theskillcorner.com
# Email provider preference: "sendgrid" or "resend" (optional, auto-detected from keys)
# SMS_RELAY_EMAIL_BACKEND=sendgrid
# Provider API keys (either SendGrid or Resend)
SMS_RELAY_SENDGRID_API_KEY=
SMS_RELAY_RESEND_API_KEY=

# --- SMS Relay Webhook Delivery Adapter Settings (if delivery provider is "webhook") ---
SMS_RELAY_WEBHOOK_URL=https://example.com/api/sms-inbox
SMS_RELAY_WEBHOOK_TOKEN=optional-bearer-token

# --- Second Brain Private API & Database Configuration ---
# Web runtime connection (restricted skill_corner_runtime role ONLY)
SECOND_BRAIN_DATABASE_URL=postgresql://skill_corner_runtime:password@ep-shiny-bar-b5dmxal3.c-7.us-east-2.aws.neon.tech/neondb?sslmode=require
# Administrative / Migration connection (NEVER expose to web application server)
SECOND_BRAIN_ADMIN_DATABASE_URL=postgresql://neondb_owner:password@ep-shiny-bar-b5dmxal3.c-7.us-east-2.aws.neon.tech/neondb?sslmode=require
# PostgreSQL TLS certificate verification override (non-production only).
# In production (NODE_ENV=production or VERCEL_ENV=production), CA verification is
# strictly enforced ({ rejectUnauthorized: true }) and setting this to "false" or using
# sslmode=disable will throw a configuration error.
# For local development against self-signed certificates only, you may set:
# SECOND_BRAIN_DB_SSL_REJECT_UNAUTHORIZED=false

# --- Twilio Inbound Webhook ---
# In production, TWILIO_AUTH_TOKEN is strictly required to verify X-Twilio-Signature on POST /api/inbound.
TWILIO_AUTH_TOKEN=
# For local dev testing only: explicitly set to "true" to permit unsigned webhooks without a token.
# Never enabled in production.
# ALLOW_UNSIGNED_TWILIO_WEBHOOKS_DEV=false
